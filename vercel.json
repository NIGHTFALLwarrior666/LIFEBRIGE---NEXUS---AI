{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=api/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path=health"
    },
    {
      "source": "/lifebridge",
      "destination": "/api/index.py?__path=lifebridge"
    },
    {
      "source": "/nexus",
      "destination": "/nexus/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path=$1"
    }
  ]
}
